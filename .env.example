# Apple Silicon Monitor — Configuration
# Copy this to .env and adjust for your setup.
# All vars are optional — defaults work for most people.

# Seconds between hardware metric samples (default: 1)
# ASIMON_POLLING_INTERVAL=1

# Base URL for the Ollama API (default: http://localhost:11434)
# ASIMON_OLLAMA_URL=http://localhost:11434

# Port for the Ollama transparent proxy (default: 11435)
# ASIMON_PROXY_PORT=11435

# Port for the Prometheus /metrics endpoint (default: 9100)
# ASIMON_METRICS_PORT=9100

# Days to keep data before automatic cleanup (default: 7)
# ASIMON_RETENTION_DAYS=7

# Path to the SQLite database file (default: ~/.asimon/data.db)
# ASIMON_DB_PATH=~/.asimon/data.db
